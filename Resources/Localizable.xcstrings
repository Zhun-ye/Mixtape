    "This will remove all downloaded songs, playlists, and cancel any active downloads. This action cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove all downloaded songs, playlists, and cancel any active downloads. This action cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera toutes les chansons téléchargées, les playlists et annulera tous les téléchargements en cours. Cette action est irréversible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera toutes les chansons téléchargées, les listes de lecture et annulera tous les téléchargements en cours. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのダウンロード済みの曲、プレイリストが削除され、進行中のダウンロードがキャンセルされます。この操作は元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将移除所有已下载的歌曲、播放列表，并取消所有正在进行的下载。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將移除所有已下載的歌曲、播放清單，並取消所有正在進行的下載。此操作無法復原。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呢個操作會移除所有已下載嘅歌曲、播放清單，並取消所有正在進行嘅下載。此操作無法復原。"
          }
        }
      }
    },
